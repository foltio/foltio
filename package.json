{
  "name": "@foltio/foltio",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source film studio with a browser editor and an MCP interface for AI agents.",
  "keywords": [
    "ai-video",
    "video-editor",
    "filmmaking",
    "mcp",
    "model-context-protocol",
    "generative-ai",
    "self-hosted"
  ],
  "homepage": "https://folt.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foltio/foltio.git"
  },
  "bugs": {
    "url": "https://github.com/foltio/foltio/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "migrate": "node scripts/migrate.mjs",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm run web:build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@supabase/supabase-js": "^2.117.3",
    "pg": "^8.23.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
