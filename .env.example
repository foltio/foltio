# Copy to .env only if you want to override the safe Docker Compose defaults.
POSTGRES_PASSWORD=foltio-local
MINIO_ROOT_USER=foltio
MINIO_ROOT_PASSWORD=foltio-local-storage

# Optional AI generation. Leave blank to use the editor without generation.
FAL_KEY=

# Browser-facing addresses. Change these together when running on another host.
FOLTIO_ORIGIN=http://localhost:3000
FOLTIO_STORAGE_ORIGIN=http://localhost:9000

# The local image includes ffmpeg. Set to 0 if a separate worker handles jobs.
STUDIO_WORKER=1
